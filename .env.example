# BlastRadius configuration (Phase 1).
# Every setting is optional; the values below are the built-in defaults.
# Copy to .env and export, or set these variables in your shell/process manager.

# --- Logging ---------------------------------------------------------------
BLASTRADIUS_LOG_LEVEL=INFO
# Emit one JSON object per log line (useful for log pipelines). Default: false.
BLASTRADIUS_LOG_JSON=false

# --- GitHub access ---------------------------------------------------------
# Optional. Raises the GitHub REST API rate limit from 60/h to 5000/h.
# NEVER committed; the value is never logged. Public repositories only.
# BLASTRADIUS_GITHUB_TOKEN=

# --- Retrieval limits ------------------------------------------------------
# auto | git | archive
BLASTRADIUS_RETRIEVAL_STRATEGY=auto
BLASTRADIUS_GIT_TIMEOUT_SECONDS=120
BLASTRADIUS_DOWNLOAD_TIMEOUT_SECONDS=60
BLASTRADIUS_MAX_DOWNLOAD_BYTES=209715200
BLASTRADIUS_MAX_EXTRACTED_BYTES=524288000
BLASTRADIUS_MAX_ARCHIVE_MEMBERS=200000
BLASTRADIUS_MAX_REPOSITORY_SIZE_KB=512000
BLASTRADIUS_MAX_INGESTION_SECONDS=300

# --- Analysis limits -------------------------------------------------------
BLASTRADIUS_MAX_FILES_SCANNED=20000
BLASTRADIUS_MAX_DIRECTORY_ENTRIES=2000
BLASTRADIUS_MAX_MANIFEST_BYTES=5242880
BLASTRADIUS_MAX_MANIFESTS=200
BLASTRADIUS_MAX_DEPENDENCIES=20000
BLASTRADIUS_MAX_CONFLICT_WARNINGS=25
BLASTRADIUS_MAX_REPORTED_SOURCE_FILES=200

# --- API -------------------------------------------------------------------
BLASTRADIUS_API_PREFIX=/api/v1
BLASTRADIUS_MAX_API_RECORDS=2000

# --- FalkorDB graph (Phase 2) ----------------------------------------------
# Graph storage is optional; the Phase 1 ingestion endpoint works without it.
BLASTRADIUS_GRAPH_HOST=localhost
BLASTRADIUS_GRAPH_PORT=6379
BLASTRADIUS_GRAPH_NAME=blastradius
BLASTRADIUS_GRAPH_DATABASE=0
# NEVER committed; only needed for authenticated FalkorDB deployments.
# BLASTRADIUS_GRAPH_USERNAME=
# BLASTRADIUS_GRAPH_PASSWORD=
BLASTRADIUS_GRAPH_SOCKET_TIMEOUT_SECONDS=10
BLASTRADIUS_GRAPH_SOCKET_CONNECT_TIMEOUT_SECONDS=5
BLASTRADIUS_GRAPH_SSL=false

# --- OSV.dev vulnerability intelligence (Phase 3) ---------------------------
# Read-only, credential-free lookups against https://api.osv.dev.
BLASTRADIUS_OSV_BASE_URL=https://api.osv.dev
# http:// is allowed only for local test doubles of the OSV API.
BLASTRADIUS_OSV_TIMEOUT_SECONDS=20
BLASTRADIUS_OSV_CONNECT_TIMEOUT_SECONDS=5
BLASTRADIUS_OSV_MAX_RETRIES=3
BLASTRADIUS_OSV_RETRY_BACKOFF_SECONDS=0.5
# querybatch chunk size sent to OSV in one request.
BLASTRADIUS_OSV_BATCH_SIZE=50
BLASTRADIUS_OSV_MAX_PAGES_PER_QUERY=5
# Refuse (instead of truncating) runs that would exceed these bounds.
BLASTRADIUS_OSV_MAX_VULNERABILITIES_PER_INGEST=200
BLASTRADIUS_OSV_MAX_PACKAGES_PER_INGEST=200
# Record size bounds applied while decoding OSV responses.
BLASTRADIUS_OSV_MAX_DETAILS_LENGTH=4000
BLASTRADIUS_OSV_MAX_REFERENCES_PER_VULNERABILITY=50

# --- User-approved GitHub issue actions (Phase 6) ---------------------------
# GitHub writes are DISABLED by default. Enabling them is an explicit,
# deliberate operator decision: without ENABLED=true both Phase 6 endpoints
# answer 403 github_write_disabled.
BLASTRADIUS_ACTIONS_ENABLED=false
# Dedicated credentials; never reuse the read-only ingestion token and never
# commit these values. The token needs repository metadata read plus
# "Issues: write" on the target; the approval secret protects confirmation and
# is never stored, logged or returned.
# BLASTRADIUS_ACTIONS_GITHUB_TOKEN=
# BLASTRADIUS_ACTIONS_APPROVAL_SECRET=
# API base (https only) and User-Agent for the dedicated issue client.
BLASTRADIUS_ACTIONS_GITHUB_API_BASE_URL=https://api.github.com
BLASTRADIUS_ACTIONS_USER_AGENT=BlastRadius/0.1 (+https://github.com/blastradius)
# Per-request timeout, preview lifetime and audit retention (seconds).
BLASTRADIUS_ACTIONS_TIMEOUT_SECONDS=20
BLASTRADIUS_ACTIONS_PREVIEW_TTL_SECONDS=900
BLASTRADIUS_ACTIONS_RETENTION_SECONDS=604800
# Persistent SQLite action store. Defaults to the platform temp directory;
# set an explicit durable path so approval/replay guarantees survive restarts.
# BLASTRADIUS_ACTIONS_STORE_PATH=
# Optional allowlist: comma-separated owner/repo entries. When set, only these
# repositories can be previewed or written to.
# BLASTRADIUS_ACTIONS_REPOSITORY_ALLOWLIST=
# Payload limits (GitHub caps titles at 256 and bodies at 65536 characters).
BLASTRADIUS_ACTIONS_MAX_TITLE_CHARS=256
BLASTRADIUS_ACTIONS_MAX_BODY_CHARS=60000

# --- AI agent (Phase 4B) ----------------------------------------------------
# The agent is optional and read-only.  Without a MODEL and an API key the ask
# endpoint answers 503 agent_not_configured; every deterministic feature
# (ingestion, graph, OSV findings, priorities, remediation, issue preview)
# keeps working without an LLM.
BLASTRADIUS_AGENT_PROVIDER=openai-compat
# BLASTRADIUS_AGENT_MODEL=gpt-4o-mini
# BLASTRADIUS_AGENT_API_KEY=            # or set OPENAI_API_KEY instead
BLASTRADIUS_AGENT_BASE_URL=https://api.openai.com/v1
# Streamable-HTTP MCP endpoint the agent queries for evidence.
BLASTRADIUS_AGENT_MCP_URL=http://127.0.0.1:8000/mcp/
# Bounded agent loop (seconds / counts / characters).
BLASTRADIUS_AGENT_TIMEOUT_SECONDS=60
BLASTRADIUS_AGENT_PROVIDER_TIMEOUT_SECONDS=30
BLASTRADIUS_AGENT_MAX_ROUNDS=4
BLASTRADIUS_AGENT_MAX_TOOL_CALLS_PER_ROUND=4
BLASTRADIUS_AGENT_MAX_QUESTION_CHARS=1000
BLASTRADIUS_AGENT_STRICT_GROUNDING=true
# Evidence budgets fed back to the model (defaults shown).  Note: when a
# tool result exceeds MAX_TOOL_RESULT_CHARS the WHOLE result is replaced by a
# {"_truncated": true, ...} stub (forcing the model to paginate with the
# tool's own skip/limit arguments), so lowering it aggressively hides data.
# Small values are only for providers with very small per-request token
# limits; paid tiers need no change.  MAX_EVIDENCE_CHARS caps the total
# evidence kept per question.
# BLASTRADIUS_AGENT_MAX_TOOL_RESULT_CHARS=20000
# BLASTRADIUS_AGENT_MAX_EVIDENCE_CHARS=120000
# BLASTRADIUS_AGENT_MAX_OUTPUT_CHARS=8000

